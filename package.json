{
  "name": "northstar-ap-ar-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Learning project: NetSuite AP/AR & Banking Payments Integration Platform for the fictional Northstar Distribution.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch middleware/src/server.ts",
    "start": "node dist/middleware/src/server.js",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "simulators": "tsx simulators/run-all.ts",
    "demo": "tsx scripts/demo.ts",
    "loadtest": "tsx scripts/load-test.ts",
    "db:migrate": "tsx middleware/src/infrastructure/db/migrate.ts",
    "ci": "npm run lint && npm run format:check && npm run typecheck && npm run check:secrets && npm run test",
    "test:report": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=reports/junit.xml",
    "smoke": "tsx scripts/smoke-test.ts",
    "check:secrets": "node scripts/check-secrets.mjs",
    "sdf:validate": "cd netsuite && npx --yes @oracle/suitecloud-cli project:validate",
    "sdf:deploy": "cd netsuite && npx --yes @oracle/suitecloud-cli project:deploy"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.12.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
