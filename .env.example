# Copy this file to .env and fill in values. NEVER commit .env.
# Every value here is a SYNTHETIC placeholder for local learning.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# "mock" uses the in-memory NetSuite simulator. "rest" calls a real NetSuite sandbox via SuiteTalk REST.
NETSUITE_MODE=mock
# Only needed when NETSUITE_MODE=rest (Token-Based Authentication / OAuth 1.0a):
NETSUITE_ACCOUNT_ID=
NETSUITE_CONSUMER_KEY=
NETSUITE_CONSUMER_SECRET=
NETSUITE_TOKEN_ID=
NETSUITE_TOKEN_SECRET=

# "memory" keeps data in RAM (tests, demo). "postgres" uses DATABASE_URL.
STORAGE_MODE=memory
DATABASE_URL=postgres://northstar:northstar@localhost:5432/northstar

# Shared secret used to verify payment-provider webhook signatures (HMAC-SHA256).
WEBHOOK_SIGNING_SECRET=change-me-local-only-secret

# Static API tokens for the learning environment. Format: token:role:subject,token:role:subject
# Roles: ap_maker, ap_checker, ar_clerk, finance (reconciliation approvals), ops, customer.  Example customer subject = NetSuite customer externalId.
API_TOKENS=dev-maker-token:ap_maker:alice,dev-checker-token:ap_checker:bob,dev-ar-token:ar_clerk:carol,dev-finance-token:finance:fiona,dev-ops-token:ops:olivia,dev-cust-acme:customer:CUST-ACME,dev-cust-globex:customer:CUST-GLOBEX

# Local folder that plays the role of the bank's SFTP server.
SFTP_ROOT=./runtime-data/sftp

# Company identity used in NACHA files (synthetic).
COMPANY_NAME=NORTHSTAR DIST
COMPANY_ID=1234567890
# 110000000 is a widely used *test* routing number (valid check digit, not a real bank account).
ORIGIN_ROUTING=110000000

# inline = follow-up work (NetSuite postings) runs right after each request; worker = background outbox worker.
DISPATCH_MODE=inline
# Per-IP request limit per minute (429 when exceeded).
RATE_LIMIT_PER_MINUTE=600
# Only during a webhook secret rotation: the OLD secret, still accepted temporarily.
# WEBHOOK_SIGNING_SECRET_PREVIOUS=
